// =========================================================
// 💈 BARBERFLOW - MODELAGEM DE BANCO DE DADOS (PAM)
// Ferramenta: dbdiagram.io (DBML - Database Markup Language)
// =========================================================

Table servicos {
  id varchar [pk, not null, note: 'Identificador único do serviço']
  nome varchar(100) [not null, note: 'Ex: Corte de Cabelo Premium']
  descricao text [not null, note: 'Procedimentos inclusos']
  preco decimal(10,2) [not null, note: 'Valor em Reais (BRL)']
  duracaoMinutos int [not null, note: 'Tempo estimado de atendimento']
  imagemUrl varchar(255) [null, note: 'Link da foto ilustrativa']
}

Table profissionais {
  id varchar [pk, not null, note: 'Identificador único do barbeiro']
  nome varchar(100) [not null, note: 'Nome completo do profissional']
  especialidade varchar(100) [not null, note: 'Área de atuação (Fade, Barba, etc)']
  avatarUrl varchar(255) [null, note: 'Foto de perfil do barbeiro']
}

Table agendamentos {
  id varchar [pk, not null, note: 'Identificador único do agendamento']
  clienteNome varchar(100) [not null, note: 'Nome completo do cliente']
  clienteTelefone varchar(20) [not null, note: 'Telefone com DDD formatado']
  servicoId varchar [not null, note: 'Chave estrangeira referenciando servicos.id']
  profissionalId varchar [not null, note: 'Chave estrangeira referenciando profissionais.id']
  data date [not null, note: 'Data no formato AAAA-MM-DD']
  hora varchar(5) [not null, note: 'Horário no formato HH:mm (08:00 às 18:00)']
  status varchar(20) [not null, default: 'agendado', note: 'agendado | concluido | cancelado']
  observacoes text [null, note: 'Notas ou preferências adicionais']
}

// ---------------------------------------------------------
// RELACIONAMENTOS E INTEGRIDADE REFERENCIAL (1 para N)
// ---------------------------------------------------------
Ref: servicos.id < agendamentos.servicoId
Ref: profissionais.id < agendamentos.profissionalId
